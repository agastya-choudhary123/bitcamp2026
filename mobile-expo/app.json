{
  "expo": {
    "name": "Safeguard AI",
    "slug": "bitcamp2026-native",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "enabled": false
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "safeguard",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#17152a"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Safeguard AI uses the front camera to monitor your eyes for signs of drowsiness while driving.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.ab1955.bitcamp2026native"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#17152a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Safeguard AI uses the front camera to monitor your eyes for signs of drowsiness while driving."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e2943215-98c4-45cc-af9e-53d6d217ec89"
      }
    }
  }
}
