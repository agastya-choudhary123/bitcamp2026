{
  "name": "driveguard-monorepo",
  "private": true,
  "description": "Monorepo for DriveGuard: AI-powered driver safety system",
  "workspaces": [
    "frontend",
    "server",
    "mobile-expo"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:server": "npm run dev --workspace=server",
    "dev:mobile": "npm run start --workspace=mobile-expo",
    "install:all": "npm install",
    "clean": "rm -rf node_modules frontend/node_modules server/node_modules mobile-expo/node_modules"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "mongodb": "^7.1.1"
  }
}
